# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ────────────────────────────────────────────
# Get this from: mongodb.com/atlas → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cartnest

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_64_character_secret_here
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────
# Get this from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Facebook OAuth ───────────────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ── Cloudinary (Image Storage) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Frontend URL (for CORS) ──────────────────────────────────
# Development: http://localhost:5173
# Production:  https://cartnest.vercel.app 
CLIENT_URL=http://localhost:5173

# ── WebAuthn / Passkey ───────────────────────────────────────
# Development values 
RP_ID=localhost
RP_NAME=CartNest
ORIGIN=http://localhost:5173

SESSION_SECRET=your-super-secret-session-key-at-least-32-chars

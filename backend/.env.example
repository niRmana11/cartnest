# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ────────────────────────────────────────────
# Get this from: mongodb.com/atlas → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cartnest

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_64_character_secret_here
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────
# Get this from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Facebook OAuth ───────────────────────────────────────────
# Get this from: developers.facebook.com → Your App → App Settings → Basic
FACEBOOK_APP_ID=0000000000000000
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ── Cloudinary (Image Storage) ───────────────────────────────
# Get this from: cloudinary.com → Dashboard
# Set up on Day 2 — leave as-is for now
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend URL (for CORS) ──────────────────────────────────
# Development: http://localhost:5173
# Production:  https://cartnest.vercel.app 
CLIENT_URL=http://localhost:5173

# ── WebAuthn / Passkey ───────────────────────────────────────
# Development values 
RP_ID=localhost
RP_NAME=CartNest
ORIGIN=http://localhost:5173
